# ── NAKPIX MCP — environment ─────────────────────────────────────────────
# Copy to .env and fill. NEVER commit .env. No seeds/private keys here.

# Backend relay (read-only HTTP surface — the MCP reuses existing processing).
# The relays are exposed behind nginx at /relay/ (Polygon) and /relay-sol-prod/
# (Solana prod). IMPORTANT: the path prefix is required — pointing at the bare
# domain returns the frontend HTML, not the relay JSON.
NAKPIX_BACKEND_URL=https://nakpix.xyz/relay
# Per-network override. Leave empty to use NAKPIX_BACKEND_URL.
NAKPIX_BACKEND_POLYGON=https://nakpix.xyz/relay
NAKPIX_BACKEND_SOLANA=https://nakpix.xyz/relay-sol-prod

# Local data directory (wallets, contacts, settings, db, logs). Defaults to ~/.nakpix
NAKPIX_HOME=

# ── Email (SMTP, transactional) — incident alerts to suporte@nakswap.xyz ──
NAKPIX_SMTP_HOST=
NAKPIX_SMTP_PORT=587
NAKPIX_SMTP_USER=
NAKPIX_SMTP_PASS=
NAKPIX_SMTP_FROM=nakpix@nakswap.xyz
NAKPIX_SMTP_TO=suporte@nakswap.xyz
NAKPIX_SMTP_TLS=true

# ── Public blockchain RPC (balance/deposit checks) ────────────────────────
POLYGON_RPC_URL=https://polygon-rpc.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Toggles ───────────────────────────────────────────────────────────────
NAKPIX_INCIDENT_MINUTES=15
NAKPIX_LOG_LEVEL=INFO
